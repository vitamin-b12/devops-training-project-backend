# Auto detect text files and perform LF normalization
* text=auto

# Force LF line endings for shell scripts
*.sh text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Force CRLF for Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf

# Force LF for configuration files
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf

# Java source files
*.java text eol=lf
*.gradle text eol=lf

# Binary files
*.jar binary
*.class binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary

